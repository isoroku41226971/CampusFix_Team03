<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · CampusFix</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Huninn&family=Noto+Sans+TC:wght@400;500;700&family=Roboto:wght@400;500;700&display=swap">
  <%# Browsers skip Huninn once Noto Sans TC covers CJK; force it so body text is really 粉圓體. Without internet the system fonts are used. %>
  <script>if (document.fonts) document.fonts.load('400 16px Huninn');</script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">CampusFix</a>
    <nav>
      <a href="/">首頁</a>
      <a href="/reports">報修列表</a>
      <a href="/reports/new">送出報修</a>
      <% const currentUser = locals.currentUser; %>
      <% if (currentUser && currentUser.role === 'staff') { %>
        <a href="/staff/reports">管理總覽</a>
      <% } %>
      <% if (currentUser) { %>
        <span class="nav-user"><%= currentUser.name %></span>
        <form class="nav-logout" method="post" action="/logout">
          <button type="submit">登出</button>
        </form>
      <% } else { %>
        <a href="/login">登入</a>
      <% } %>
    </nav>
  </header>
  <main class="container">
