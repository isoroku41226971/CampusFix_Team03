<%- include('../partials/header') %>

<h1>處理報修</h1>
<p class="report-no"><%= report.reportNo %></p>

<% if (message) { %>
  <div class="notice notice-success" role="status"><%= message %></div>
<% } %>
<% if (error) { %>
  <div class="notice notice-error" role="alert"><%= error %></div>
<% } %>

<dl class="report-summary">
  <dt>標題</dt><dd><%= report.title %></dd>
  <dt>地點</dt><dd><%= report.location %></dd>
  <dt>類別</dt><dd><%= report.category %></dd>
  <dt>描述</dt><dd class="multiline"><%= report.description %></dd>
  <dt>送出時間</dt><dd><%= report.created_at %></dd>
  <dt>目前狀態</dt><dd><span class="status status-<%= report.status.toLowerCase().replace(' ', '-') %>"><%= report.status %></span></dd>
  <% if (report.status === 'Resolved') { %>
    <dt>處理說明</dt><dd class="multiline"><%= report.resolution_note || '尚未提供處理說明' %></dd>
  <% } %>
</dl>

<section class="staff-actions" aria-labelledby="actions-title">
  <h2 id="actions-title">變更狀態</h2>
  <% if (nextStatuses.length === 0) { %>
    <p class="lead">目前狀態沒有可以進行的變更。</p>
  <% } %>
  <% nextStatuses.forEach(function (status) { %>
    <form method="post" action="/staff/reports/<%= report.id %>/status" novalidate>
      <input type="hidden" name="status" value="<%= status %>">
      <% if (status === 'Resolved') { %>
        <%# Resolving needs a resolution note (WD-26); students see it on the detail page. %>
        <div class="field">
          <label for="resolution_note">處理說明</label>
          <textarea id="resolution_note" name="resolution_note" rows="4" maxlength="<%= maxNote %>" required
                    placeholder="請寫下處理結果，例如：已更換燈泡"
                    aria-describedby="resolution_note-error" <%= noteError ? 'aria-invalid=true' : '' %>><%= noteValue %></textarea>
          <p class="field-error" id="resolution_note-error" <%= noteError ? '' : 'hidden' %>><%= noteError || '' %></p>
        </div>
        <button type="submit" class="btn">結案（改為 Resolved）</button>
      <% } else { %>
        <button type="submit" class="btn">改為 <%= status %></button>
      <% } %>
    </form>
  <% }) %>
</section>

<p><a href="/staff/reports">回到管理總覽</a> · <a href="/reports/<%= report.id %>">查看學生看到的詳情頁</a></p>

<%- include('../partials/footer') %>
