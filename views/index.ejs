<%- include('partials/header') %>

<section class="home">
  <div class="home-deco home-deco-circle" aria-hidden="true"></div>
  <div class="home-deco home-deco-square" aria-hidden="true"></div>
  <div class="home-content">
    <h1>CampusFix</h1>
    <p class="home-fullname">校園報修系統</p>
    <p class="home-subtitle">學生可以回報教室設備故障、設施損壞、Wi-Fi 問題等校園狀況，並追蹤處理進度；管理人員可以查看報修並記錄處理結果。</p>
    <div class="home-cards">
      <a class="home-card home-card-primary" href="/reports/new">
        <span class="home-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </span>
        <span class="title">送出報修</span>
        <span class="muted">描述問題，拿到報修編號</span>
      </a>
      <a class="home-card home-card-deep" href="/reports">
        <span class="home-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </span>
        <span class="title">報修列表</span>
        <span class="muted">搜尋報修、查看處理進度</span>
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
